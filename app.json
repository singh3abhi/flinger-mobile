{
  "expo": {
    "name": "Flinger",
    "slug": "flinger",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flinger",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.flinger.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.flinger.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFF3EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFBF8",
          "image": "./assets/images/logo.png",
          "imageWidth": 100
        }
      ],
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flinger uses your location to show you people nearby. Others only see how far away you are, never where you are."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
